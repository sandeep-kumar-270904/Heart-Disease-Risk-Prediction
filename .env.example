# ==============================================================================
# HeartXAI 2.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# IMPORTANT:
#   - Never commit .env files or real credentials.
#   - In ENVIRONMENT=staging or ENVIRONMENT=production, SECRET_KEY MUST be
#     replaced with a strong (>=32 char) non-placeholder secret and DEBUG=false,
#     or application startup fails closed.
# ==============================================================================

# Runtime Environment ("development", "test", "staging", "production")
ENVIRONMENT=development
DEBUG=true

# Mandatory Data Governance (DEC-005: Category C real patient data is strictly prohibited)
SYNTHETIC_DATA_ONLY=true

# Application Metadata
PROJECT_NAME="HeartXAI 2.0"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Service Ports (Host Mappings for root docker-compose.yml)
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Database Configuration
# Local SQLite fallback (default if DATABASE_URL unset): sqlite:///./heartxai_dev.db
# Local Docker Compose: postgresql://heartxai_user:heartxai_password@localhost:5432/heartxai_db
# Container-to-container: postgresql://heartxai_user:heartxai_password@db:5432/heartxai_db
POSTGRES_USER=heartxai_user
POSTGRES_PASSWORD=heartxai_password
POSTGRES_DB=heartxai_db
DATABASE_URL=postgresql://heartxai_user:heartxai_password@localhost:5432/heartxai_db

# Redis Cache & Token Blacklist Store
# Local Docker Compose: redis://localhost:6379/0
# Container-to-container: redis://cache:6379/0
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
# Local dev only when ENVIRONMENT=development|test.
# Staging/Production MUST inject a strong random key (>=32 chars, e.g. `openssl rand -hex 32`).
SECRET_KEY=hxai-local-dev-only-key-not-for-staging-or-production-0000000000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Machine Learning Subsystem
MODEL_DIR=app/ml/artifacts
ACTIVE_MODEL_VERSION=v2.0.0

# Optional Infra Compose TLS & AEAD Backup Variables (supply via secrets/env, never commit)
# TLS_CERT_DIR=./infra/nginx/certs
# BACKUP_ENCRYPTION_KEY=replace-with-strong-backup-passphrase-min-16-chars
